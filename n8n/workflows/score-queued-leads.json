{
  "name": "LeadHunter: Score queued leads",
  "nodes": [
    {
      "id": "33333333-0000-4000-8000-000000000001",
      "name": "Run scoring",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "33333333-0000-4000-8000-000000000002",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "app-url",
              "name": "appUrl",
              "value": "https://REPLACE-ME.trycloudflare.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "33333333-0000-4000-8000-000000000003",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The limit is how many queued leads to score in this run, from 1 to 10.\nconst rawBody = JSON.stringify({ limit: 5 });\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn [{ json: { rawBody, timestamp, signingInput: `${timestamp}.${rawBody}` } }];"
      }
    },
    {
      "id": "33333333-0000-4000-8000-000000000004",
      "name": "Sign request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "binaryData": false,
        "value": "={{ $json.signingInput }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "name": "LeadHunter n8n to app"
        }
      }
    },
    {
      "id": "33333333-0000-4000-8000-000000000005",
      "name": "Score queued leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.appUrl }}/api/internal/qualify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-leadhunter-timestamp",
              "value": "={{ String($('Build request').first().json.timestamp) }}"
            },
            {
              "name": "x-leadhunter-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $('Build request').first().json.rawBody }}",
        "options": {
          "timeout": 300000
        }
      }
    }
  ],
  "connections": {
    "Run scoring": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Build request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build request": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Score queued leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
