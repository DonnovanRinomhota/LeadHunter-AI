{
  "name": "leadhunter-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "npx --yes supabase@2.122.1 start",
    "db:stop": "npx --yes supabase@2.122.1 stop",
    "db:reset": "npx --yes supabase@2.122.1 db reset",
    "db:test": "npx --yes supabase@2.122.1 test db",
    "db:types": "npx --yes supabase@2.122.1 gen types typescript --local > src/contracts/database.types.ts",
    "dev:user": "node --env-file=.env.local scripts/create-local-user.mjs",
    "dev:score": "node --env-file=.env.local scripts/score-local.mjs",
    "eval:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --mode live --disableConsoleIntercept"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.4",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
