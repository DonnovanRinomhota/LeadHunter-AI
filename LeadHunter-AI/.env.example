# Web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase - use the anon/public key in browser-side code only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server-side only; NEVER expose to browser

# AI provider - configure only the provider selected by the team.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# n8n
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=

# Telegram internal notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEAM_CHAT_ID=

# Optional permitted search/source provider
LEAD_SOURCE_API_KEY=

# Application security
APP_ENCRYPTION_KEY=
